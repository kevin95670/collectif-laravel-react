APP_NAME=Collectif
APP_ENV=production
# La clé est générée sur le serveur avec "php artisan key:generate"
APP_KEY=
APP_DEBUG=false
APP_URL=https://collectif.kevinleonard.fr
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# Le site React et l'API sont sur le même domaine
FRONTEND_URL=https://collectif.kevinleonard.fr
SANCTUM_STATEFUL_DOMAINS=collectif.kevinleonard.fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de données Hostinger (le mot de passe se met seulement sur le serveur)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u713948819_collectif
DB_USERNAME=u713948819_collectif
DB_PASSWORD=

# Pas de Redis sur l'hébergement : fichiers pour les sessions et le cache,
# base de données pour la file d'attente
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=database

# Les e-mails seront réglés plus tard (étape dédiée) : en attendant, ils vont dans les logs
MAIL_MAILER=log
MAIL_FROM_ADDRESS="contact@kevinleonard.fr"
MAIL_FROM_NAME="${APP_NAME}"

BCRYPT_ROUNDS=12